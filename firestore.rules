rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /Users/{userId} {
      // Allow any authenticated user to read basic user profiles
      allow read: if request.auth != null;
      
      // Users can create their own profile
      allow create: if request.auth != null &&
                    request.auth.uid == userId &&
                    request.resource.data.uid == userId;
      
      // Users can update their own profile
      allow update: if request.auth != null &&
                    request.auth.uid == userId;
      
      // Admins can write any user document
      allow write: if request.auth != null &&
                   get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin";

      // Notifications subcollection under Users
      match /Notifications/{notificationId} {
        allow read: if request.auth != null &&
                    (userId == request.auth.uid ||
                     get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin");
        allow create: if request.auth != null;
        allow update: if request.auth != null &&
                      (userId == request.auth.uid ||
                       get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin");
        allow delete: if request.auth != null &&
                      (userId == request.auth.uid ||
                       get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin");
      }
    }

    // LoginAttempts collection
    match /LoginAttempts/{document=**} {
      // Allow anyone to create login attempts (even unauthenticated users)
      allow create: if true;
      
      // Only allow admins to read or write login attempts
      allow read, write: if request.auth != null &&
                         get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin";
    }

    // UserLog collection
    match /UserLog/{logId} {
      // Allow users to create their own log entries
      allow create: if request.auth != null &&
                    request.resource.data.userId == request.auth.uid;
      
      // Admin-only access for reading and other operations
      allow read, update, delete: if request.auth != null &&
                                  get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin";
    }

    // Public site content (privacy/terms etc.)
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if request.auth != null &&
                   get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin";
    }
      // Add this new rule for file_hashes collection
    match /file_hashes/{document=**} {
      // Allow any authenticated user to read (for duplicate checking)
      allow read: if request.auth != null;
      
      // Only allow creation of new hashes during file uploads
      allow create: if request.auth != null && 
                    request.resource.data.uploadedBy == request.auth.uid;
      
      // Only allow updates to add new versions
      allow update: if request.auth != null && 
                    request.auth.uid == resource.data.uploadedBy;
      
      // Prevent deletion to maintain data integrity
      allow delete: if false;
    }


match /manuscripts/{manuscriptId} {
  // Allow any authenticated user to read manuscripts
  allow read: if request.auth != null;

  // Allow any authenticated user to create manuscripts
  allow create: if request.auth != null;

  // Update permissions
  allow update: if request.auth != null && (
    // Allow submitters to update their own manuscripts
    resource.data.submitterId == request.auth.uid ||

    // Allow admins to update any manuscript
    get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin" ||

    // Allow reviewers to update their assigned manuscripts
    (resource.data.assignedReviewers != null && 
     resource.data.assignedReviewers.hasAny([request.auth.uid])) ||

    // Special case for resubmission
    (resource.data.submitterId == request.auth.uid && 
     (resource.data.status == "For Revision (Minor)" || 
      resource.data.status == "For Revision (Major)") &&
     // Ensure the status is being changed to "Back to Admin"
     request.resource.data.status == "Back to Admin")
  );

  // Only allow admins to delete
  allow delete: if request.auth != null &&
                get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin";

  // adminFeedback subcollection
  match /adminFeedback/{feedbackId} {
    // Helper function to check if user is a co-author
    function isCoAuthor() {
      let manuscript = get(/databases/$(database)/documents/manuscripts/$(manuscriptId));
      return manuscript.data.coAuthorsIds != null && 
             manuscript.data.coAuthorsIds.hasAny([request.auth.uid]);
    }

    // For list operations (collection queries)
    allow list: if request.auth != null && (
      get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin" ||
      get(/databases/$(database)/documents/manuscripts/$(manuscriptId)).data.submitterId == request.auth.uid ||
      isCoAuthor()
    );

    // For get operations (single document reads)
    allow get: if request.auth != null && (
      get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin" ||
      resource.data.createdBy == request.auth.uid ||
      get(/databases/$(database)/documents/manuscripts/$(manuscriptId)).data.submitterId == request.auth.uid ||
      isCoAuthor()
    );

    allow create: if request.auth != null && (
      get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin" ||
      (
        request.resource.data.createdBy == request.auth.uid &&
        (
          get(/databases/$(database)/documents/manuscripts/$(manuscriptId)).data.submitterId == request.auth.uid ||
          isCoAuthor()
        )
      )
    );

    allow update: if request.auth != null && (
      get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin" ||
      resource.data.createdBy == request.auth.uid
    );

    allow delete: if request.auth != null &&
                  get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin";
  }

  // revisionHistory subcollection
  match /revisionHistory/{revisionId} {
    // Allow read for submitter, co-authors, and admins
    allow read: if request.auth != null && (
      get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin" ||
      get(/databases/$(database)/documents/manuscripts/$(manuscriptId)).data.submitterId == request.auth.uid ||
      (get(/databases/$(database)/documents/manuscripts/$(manuscriptId)).data.coAuthorsIds != null && 
       get(/databases/$(database)/documents/manuscripts/$(manuscriptId)).data.coAuthorsIds.hasAny([request.auth.uid]))
    );

    // Allow creation when resubmitting
    allow create: if request.auth != null && (
      get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin" ||
      get(/databases/$(database)/documents/manuscripts/$(manuscriptId)).data.submitterId == request.auth.uid
    );

    // Only allow admins to update or delete
    allow update, delete: if request.auth != null &&
                         get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin";
  }
}
 match /completedReviews/{reviewId} {
  allow read: if request.auth != null && (
    get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin" ||
    resource.data.reviewerId == request.auth.uid ||
    get(/databases/$(database)/documents/manuscripts/$(resource.data.manuscriptId)).data.submitterId == request.auth.uid
  );

  // Allow reviewers to create their own completed reviews
  allow create: if request.auth != null && (
    // Allow if the user is the reviewer in the document
    request.resource.data.reviewerId == request.auth.uid ||
    // Or if the user is an admin
    get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin"
  );
  
  // Only allow updates by admins
  allow update: if request.auth != null &&
                get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin";
  
  allow delete: if false; // disallow deletes for completed reviews by users
}

    // deadlineSettings collection (admin only writes)
    match /deadlineSettings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                   get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin";
    }

 
    match /formatGuidelines/{document=**} {
      // Allow read access to all users
      allow read: if true;
      
      // Allow create/update/delete for authenticated users
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // forms collection
    match /forms/{formId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                   get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin";
    }

    // submissionCounters collection - temporarily permissive for authenticated users
    match /submissionCounters/{counterId} {
      allow read, write: if request.auth != null;
    }

    // Content collection (for static content)
    match /Content/{document} {
      allow read: if true;
      allow write: if request.auth != null &&
                   get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin";
    }

    // Legal pages collection (Privacy Policy, Terms of Service, etc.)
    match /legalPages/{document} {
      allow read: if true;  // Public read access for everyone
      allow write: if request.auth != null && 
                   get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "Admin";
    }
  }
}